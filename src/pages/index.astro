---
import Navbar from "../components/Navbar.astro";
import LandingHero from "../components/LandingHero.astro";
import VideoSection from "../components/VideoSection.astro";
import WritingSection from "../components/WritingSection.astro";
import GradientSection from "../components/contact/GradientSection.astro";
import ContactSection from "../components/contact/ContactSection.astro";
import ContactFooter from "../components/contact/ContactFooter.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/jerick.png" />
    <title>Jerick Yacat Portfolio | Artist and Videographer in the NYC Area</title>
    <meta name="description" content="Learn more about Jerick's videos and writing, including My Dollar!">
  </head>
  <body id="top">
    <Navbar />
    <main>
      <LandingHero />
      <VideoSection />
      <WritingSection />
      <GradientSection />
      <ContactSection />
      <ContactFooter />
    </main>
  </body>
</html>
