---
import Header from "./Header.astro";
import WritingCard from "./WritingCard.astro";
import { writingItems } from "../data/portfolio";
---

<section id="writing" class="bg-sky-500 px-5 py-10" aria-label="Writing portfolio">
  <div class="mx-auto max-w-5xl lg:max-w-5xl">
    <Header title="Writing" align="right" />

    <div class="grid grid-cols-1 gap-x-5 gap-y-9 md:grid-cols-2 md:gap-x-10 md:gap-y-12">
      {
        writingItems.map((item, index) => (
          <WritingCard item={item} align={index % 2 === 0 ? "left" : "right"} />
        ))
      }
    </div>
  </div>
</section>
