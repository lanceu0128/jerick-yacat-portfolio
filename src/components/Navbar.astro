---
import Menu from "./Lucide/Menu.astro";
import "../styles/global.css";

const navItems = ["Video", "Writing", "Contact"];
---

<header class="sticky top-0 z-10 bg-sky-500 text-white">
  <nav
    class="mx-auto flex h-16 w-full items-center justify-between px-4 md:h-18 md:px-8"
    aria-label="Primary navigation"
  >
    <a class="flex min-w-0 items-center gap-3 text-white no-underline" href="#top">
      <img
        class="size-11 rounded-full object-cover"
        src="/jerick.png"
        alt="Jerick Yacat"
        aria-label="Jerick Yacat Home"
      />
    </a>

    <div>
      <button
        class="flex size-11 items-center justify-end text-white md:hidden"
        type="button"
        aria-label="Open navigation"
      >
        <Menu />
      </button>

      <div class="hidden items-center gap-7 md:flex">
        {
          navItems.map((item) => (
            <a
              class="text-lg leading-none text-white no-underline font-sans font-bold"
              href={`#${item.toLowerCase()}`}
            >
              {item}
            </a>
          ))
        }
      </div>
    </div>
  </nav>
</header>
