---
---

<section 
  class:list={[
    "relative",
    "isolate",
    "overflow-x-clip",
    "overflow-y-visible",
    "grid",
    "min-h-[calc(100svh-4rem)]",
    "grid-rows-[58fr_42fr]",
  ]}
  aria-label="Jerick Yacat landing page"
>
  <div
    class:list={[
      "bg-sky-500 flex",
      "items-center justify-center text-center",
      "md:text-left md:items-end md:justify-start"
    ]}
  >
    <div class="text-white font-mono font-bold md:ml-10 md:mb-5">
      <h1 class="text-4xl md:text-8xl font-bold">Jerick Yacat</h1>
      <h2 class="text-2xl md:text-4xl font-bold">Artist and Videographer</h2>
    </div>
  </div>
  <div class="relative bg-yellow-100">
    <img
        class:list={[
        "pointer-events-none",
        "absolute",
        "max-w-none",
        "bottom-[-14%] right-[-60%] h-[139%]",
        "md:bottom-[-14%] md:right-[6%] md:h-[138%]",
        ]}
        src="/hero.PNG"
        alt="Illustration of Jerick Yacat"
    />
  </div>
</section>
