---
import type { PortfolioItem } from "../data/portfolio";

interface Props {
  item: PortfolioItem;
  align?: "left" | "right";
}

const { item, align = "left" } = Astro.props;
const textAlign =
  align === "right" ? "items-end text-right md:items-start md:text-left" : "items-start text-left";
---

<article class="font-mono text-white">
  <div class="mb-2 block border-4 border-yellow-100 bg-black">
    <span class:list={["relative block overflow-hidden", item.embedSrc ? "aspect-4/5" : "aspect-video"]}>
      {
        item.embedSrc ? (
          <iframe
            class="size-full"
            src={item.embedSrc}
            title={item.embedTitle ?? item.title}
            loading="lazy"
            allow="fullscreen"
            allowfullscreen
          />
        ) : (
          <a
            class:list={[
              "block size-full transition-opacity",
              item.href ? "hover:opacity-85" : "pointer-events-none",
            ]}
            href={item.href ?? undefined}
            target={item.href ? "_blank" : undefined}
            rel={item.href ? "noreferrer" : undefined}
            aria-label={item.href ? item.title : undefined}
          >
            <img
              class="size-full object-cover"
              src={item.imageSrc}
              alt={item.imageAlt}
              onerror="this.onerror=null;this.src='/temp-thumbnail.png';"
            />
          </a>
        )
      }
    </span>
  </div>

  <div class:list={["flex flex-col", textAlign]}>
    <h3 class="text-2xl font-bold uppercase leading-none md:text-3xl">{item.title}</h3>
    <div class="mt-1 h-1 w-20 bg-yellow-100 md:w-24" aria-hidden="true"></div>
    <p class="mt-1 text-md font-bold leading-tight md:text-lg">{item.description}</p>
    {
      item.note && (
        <p class="mt-2 text-sm font-bold italic leading-tight md:text-base">
          {item.note}
        </p>
      )
    }
  </div>
</article>
