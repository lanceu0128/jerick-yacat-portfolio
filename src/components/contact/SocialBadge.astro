---
const instagramUrl = "https://www.instagram.com/jeknewart/";
---

<div class="relative h-full w-full">
  <div class="absolute right-0 bottom-0 h-[calc(100%-0.5rem)] w-[calc(100%-0.5rem)] bg-sky-500" aria-hidden="true"></div>

  <div class="absolute top-0 left-0 h-[calc(100%-0.5rem)] w-[calc(100%-0.5rem)] bg-white px-5 py-5 font-mono text-sky-500">
    <a
      class="inline-flex items-center gap-3 text-2xl font-bold text-sky-500 no-underline transition-opacity hover:opacity-80"
      href={instagramUrl}
      target="_blank"
      rel="noreferrer"
      aria-label="Jerick Yacat on Instagram"
    >
      <svg
        class="size-14 shrink-0"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
        <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
      </svg>
      <span>@jeknewart</span>
    </a>

    <div class="mt-4 h-1.5 w-40 bg-sky-500" aria-hidden="true"></div>

    <p class="mt-5 max-w-72 text-2xl font-bold leading-tight">
      Based in the NYC Metropolitan Area!
    </p>
  </div>
</div>
