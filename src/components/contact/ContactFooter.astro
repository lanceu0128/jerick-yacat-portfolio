---
const codeUrl = "https://github.com/lanceu0128";
---

<section class="bg-yellow-100 pt-40 md:pt-5" aria-label="Site credit">
  <div class="relative h-16 overflow-y-visible bg-sky-500">
    <a
      class="group absolute bottom-0 left-1/2 block w-96 -translate-x-1/2 hover:scale-105"
      href={codeUrl}
      target="_blank"
      rel="noreferrer"
      aria-label="Website code by Lance"
    >
      <span
        class="absolute bottom-24 left-1/2 -translate-x-1/2 whitespace-nowrap bg-white px-3 py-1 font-mono text-sm font-bold text-sky-500 md:opacity-0 md:group-hover:opacity-100"
      >
        Website code by Lance
      </span>

      <img
        class="pointer-events-none w-full"
        src="/lance.png"
        alt=""
        aria-hidden="true"
      />
    </a>
  </div>
</section>
