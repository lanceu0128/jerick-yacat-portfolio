---
---

<form class="font-mono text-sky-500" aria-label="Contact form">
  <div class="grid gap-3">
    <label class="grid text-base font-bold md:text-lg">
      <span class="sr-only">Name</span>
      <input
        class="h-10 border-4 border-sky-500 bg-white px-3 font-mono text-lg text-sky-500 outline-none placeholder:text-sky-500 md:h-12 md:text-xl"
        type="text"
        name="name"
        placeholder="Name:"
      />
    </label>

    <label class="grid text-base font-bold md:text-lg">
      <span class="sr-only">Email</span>
      <input
        class="h-10 border-4 border-sky-500 bg-white px-3 font-mono text-lg text-sky-500 outline-none placeholder:text-sky-500 md:h-12 md:text-xl"
        type="email"
        name="email"
        placeholder="Email:"
      />
    </label>

    <label class="grid text-base font-bold md:text-lg">
      <span class="sr-only">Message</span>
      <textarea
        class="min-h-40 resize-none border-4 border-sky-500 bg-white px-3 py-2 font-mono text-lg text-sky-500 outline-none placeholder:text-sky-500 md:min-h-52 md:py-3 md:text-xl"
        name="message"
        placeholder="Message:"
      ></textarea>
    </label>
  </div>

  <div class="mt-5 flex justify-end">
    <button
      class="rounded-full bg-sky-500 px-8 py-2.5 font-mono text-lg font-bold text-white md:py-3"
      type="button"
    >
      Send
    </button>
  </div>
</form>
